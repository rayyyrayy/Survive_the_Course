  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>Offline (Single Player)</b> \n\u2022 <i>Goal:</i> Survive as long as
    possible. \n\u2022 <i>The Enemy:</i> A relentless AI is hunting you. \n\u2022
    <i>Scoring:</i> You earn 1 point for every second you stay alive.\n\n<b>Online
    (1v1 Multiplayer)</b> \n\u2022 <i>The Match:</i> Best of 2 rounds. You will play
    one round as the Runner, and one round as the Chaser. \n\u2022 <i>The Runner:</i>
    Survive! Earn 1 point per second alive (Max: 90). \n\u2022 <i>The Chaser:</i>
    Hunt! Start with 90 points, lose 1 point per second until you catch the Runner.
    \n\u2022 <i>Winning:</i> The player with the highest combined score at the end
    of Round 2 wins."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
